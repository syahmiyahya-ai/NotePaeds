{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotePaeds",
  "version": "9.3.5",
  "identifier": "my.gov.hta.notepaeds",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Untitled - Notepad",
        "width": 1060,
        "height": 720,
        "minWidth": 720,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": false,
        "shadow": true,
        "theme": "Light",
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://syahmiyahya-ai.github.io"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Notepad-style paediatric clinical drafting workspace",
    "longDescription": "NotePaeds 9.3.5 is an offline multi-patient clinical scratchpad with central module updates, expanded parsers, smart clinical prompts, portable modules, timers and alarms.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

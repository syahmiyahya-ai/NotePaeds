    {
      "id": "pecarn",
      "kind": "risk-rule",
      "label": "PECARN",
      "title": "PECARN — minor head injury",
      "eligibility": "For children under 18 with blunt head injury within 24 hours and GCS 14–15. Do not apply with suspected abuse, penetrating injury, bleeding disorder, ventricular shunt, brain tumour, neurological disease affecting assessment, or prior CT for this injury. Trivial injury without symptoms except abrasions/lacerations was not studied. Use clinical judgement; this is not a numerical score.",
      "note": "Two age-specific pathways; all findings must be assessed. A low-risk result does not replace reassessment or safety-netting.",
      "reference": "Altered mental state: agitation, unusual drowsiness, repeated questions or slow verbal response. Basal skull signs: bruising behind ears/around eyes, blood behind the eardrum or CSF leak.\nSevere mechanism: vehicle crash with ejection, rollover or another passenger killed; pedestrian or unhelmeted cyclist hit by a motor vehicle; high-impact object striking the head; fall >0.9 m if under 2, or >1.5 m if aged 2–17.\nFor intermediate risk, weigh observation versus CT using symptom progression, multiple findings, clinician experience and caregiver preference. Take extra care in infants under 3 months. Percentages are cohort estimates, not personalised probabilities.",
      "source": "Kuppermann et al. Lancet 2009;374:1160–70, Figure 3. CHOP Acute Head Trauma Pathway. Checked 12 September 2026.",
      "sourceUrl": "https://www.pecarn.org/studyDatasets/documents/Kuppermann_2009_The-Lancet_000.pdf",
      "bands": [
        {
          "id": "under2",
          "label": "under 2 years",
          "fields": [
            {
              "id": "mental",
              "label": "GCS 14 or altered mental state?",
              "risk": "high"
            },
            {
              "id": "skull",
              "label": "Palpable skull fracture?",
              "risk": "high"
            },
            {
              "id": "haematoma",
              "label": "Scalp haematoma at the temporal, parietal or occipital area?",
              "risk": "intermediate"
            },
            {
              "id": "loc",
              "label": "Loss of consciousness lasting at least 5 seconds?",
              "risk": "intermediate"
            },
            {
              "id": "mechanism",
              "label": "Severe mechanism (see reference for age-specific fall threshold)?",
              "risk": "intermediate"
            },
            {
              "id": "behaviour",
              "label": "Parent reports behaviour is not back to normal?",
              "risk": "intermediate"
            }
          ],
          "outcomes": {
            "high": "Higher risk — CT recommended by rule; clinician review required.",
            "intermediate": "Intermediate risk — observation versus CT; clinical judgement required.",
            "low": "Very low risk — CT generally not indicated by rule; reassess and safety-net."
          }
        },
        {
          "id": "2to17",
          "label": "2–17 years",
          "fields": [
            {
              "id": "mental",
              "label": "GCS 14 or altered mental state?",
              "risk": "high"
            },
            {
              "id": "skull",
              "label": "Signs of a basal skull fracture?",
              "risk": "high"
            },
            {
              "id": "loc",
              "label": "Any loss of consciousness after injury?",
              "risk": "intermediate"
            },
            {
              "id": "vomiting",
              "label": "Vomiting after the injury?",
              "risk": "intermediate"
            },
            {
              "id": "mechanism",
              "label": "Severe mechanism (see reference for age-specific fall threshold)?",
              "risk": "intermediate"
            },
            {
              "id": "headache",
              "label": "Severe headache?",
              "risk": "intermediate"
            }
          ],
          "outcomes": {
            "high": "Higher risk — CT recommended by rule; clinician review required.",
            "intermediate": "Intermediate risk — observation versus CT; clinical judgement required.",
            "low": "Very low risk — CT generally not indicated by rule; reassess and safety-net."
          }
        }
      ]
    },

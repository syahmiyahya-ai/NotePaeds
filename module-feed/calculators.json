          "options": [
            {
              "label": "Normal",
              "score": 0
            },
            {
              "label": "Decreased",
              "score": 1
            },
            {
              "label": "Markedly decreased",
              "score": 2
            }
          ]
        },
        {
          "id": "retractions",
          "label": "Retractions",
          "options": [
            {
              "label": "None",
              "score": 0
            },
            {
              "label": "Mild",
              "score": 1
            },
            {
              "label": "Moderate",
              "score": 2
            },
            {
              "label": "Severe",
              "score": 3
            }
          ]

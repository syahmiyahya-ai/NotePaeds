    {
      "id": "pas",
      "kind": "score",
      "title": "Paediatric Asthma Score (PAS)",
      "label": "PAS",
      "enabled": true,
      "note": "Supplied PAS table. Age 4 overlaps in the 2–4 and 4–5 year bands: select the applicable band explicitly. No respiratory-rate band supplied outside these ages. Select assessed findings only; use the more severe side if asymmetric.",
      "source": "User-supplied PAS reference",
      "contexts": [
        {
          "id": "ageBand",
          "label": "Respiratory-rate age band",
          "options": [
            "2–4 years",
            "4–5 years",
            "6–12 years"
          ]
        }
      ],
      "fields": [
        {
          "id": "rr",
          "label": "Respiratory rate (breaths/min)",
          "context": "ageBand",
          "variants": {
            "2–4 years": [
              {
                "label": "≤34",
                "score": 1
              },
              {
                "label": "35–39",
                "score": 2
              },
              {
                "label": "≥40",
                "score": 3
              }
            ],
            "4–5 years": [
              {
                "label": "≤30",
                "score": 1
              },
              {
                "label": "31–35",
                "score": 2
              },
              {
                "label": "≥36",
                "score": 3
              }
            ],
            "6–12 years": [
              {
                "label": "≤26",
                "score": 1
              },
              {
                "label": "27–30",
                "score": 2
              },
              {
                "label": "≥31",
                "score": 3
              }
            ]
          }
        },
        {
          "id": "oxygen",
          "label": "Oxygen saturation",
          "options": [
            {
              "label": ">95% on room air",
              "score": 1
            },
            {
              "label": "90–95% on room air",
              "score": 2
            },
            {
              "label": "<90% on room air OR supplemental oxygen",
              "score": 3
            }
          ]
        },
        {
          "id": "breath",
          "label": "Breath sounds",
          "options": [
            {
              "label": "Normal breathing or end-expiratory wheeze",
              "score": 1
            },
            {
              "label": "Expiratory wheeze",
              "score": 2
            },
            {
              "label": "Inspiratory and expiratory wheeze, reduced breath sounds, or both",
              "score": 3
            }
          ]
        },
        {
          "id": "retractions",
          "label": "Retractions",
          "options": [
            {
              "label": "None or intercostal",
              "score": 1
            },
            {
              "label": "Intercostal and substernal",
              "score": 2
            },
            {
              "label": "Intercostal, substernal and supraclavicular",
              "score": 3
            }
          ]
        },
        {
          "id": "dyspnoea",
          "label": "Dyspnoea",
          "options": [
            {
              "label": "Speaks in sentences",
              "score": 1
            },
            {
              "label": "Partial sentences or short cries",
              "score": 2
            },
            {
              "label": "Single words, short phrases or grunts",
              "score": 3
            }
          ]
        }
      ],
      "severity": [
        {
          "min": 5,
          "max": 7,
          "label": "Mild"
        },
        {
          "min": 8,
          "max": 11,
          "label": "Moderate"
        },
        {
          "min": 12,
          "max": 15,
          "label": "Severe"
        }
      ]
    },
    {
      "id": "pram",
      "kind": "score",
      "title": "Paediatric Respiratory Assessment Measure (PRAM)",
      "label": "PRAM",
      "enabled": true,
      "note": "Complete all five assessed components. Oxygen saturation uses a room-air assessment; do not assume room air or interrupt needed oxygen just to obtain a score. With asymmetric air entry, use the worst-affected lung field. For asymmetric wheeze, use the two worst auscultation zones. A silent chest with minimal/no air entry scores 3 for wheeze, not 0.",
      "source": "Canadian Paediatric Society — Managing an acute asthma exacerbation in children, Table 1 (2021); checked 10 September 2026.",
      "sourceUrl": "https://cps.ca/documents/position/managing-an-acute-asthma-exacerbation",
      "contexts": [],
      "fields": [
        {
          "id": "oxygen",
          "label": "Oxygen saturation (room air)",
          "options": [
            {
              "label": "95% or above",
              "score": 0
            },
            {
              "label": "92–94%",
              "score": 1
            },
            {
              "label": "Below 92%",
              "score": 2
            }
          ]
        },
        {
          "id": "suprasternal",
          "label": "Suprasternal retraction",
          "options": [
            {
              "label": "Not present",
              "score": 0
            },
            {
              "label": "Present",
              "score": 2
            }
          ]
        },
        {
          "id": "scalene",
          "label": "Scalene muscle contraction",
          "options": [
            {
              "label": "Not present",
              "score": 0
            },
            {
              "label": "Present",
              "score": 2
            }
          ]
        },
        {
          "id": "air",
          "label": "Air entry",
          "options": [
            {
              "label": "Normal",
              "score": 0
            },
            {
              "label": "Reduced at bases",
              "score": 1
            },
            {
              "label": "Reduced at both apices and bases",
              "score": 2
            },
            {
              "label": "Minimal or absent",
              "score": 3
            }
          ]
        },
        {
          "id": "wheeze",
          "label": "Wheeze",
          "options": [
            {
              "label": "No wheeze (not a silent chest)",
              "score": 0
            },
            {
              "label": "On expiration only",
              "score": 1
            },
            {
              "label": "On inspiration, with or without expiratory wheeze",
              "score": 2
            },
            {
              "label": "Audible without a stethoscope, OR silent chest with minimal/no air entry",
              "score": 3
            }
          ]
        }
      ],
      "severity": [
        {
          "min": 0,
          "max": 3,
          "label": "Mild"
        },
        {
          "min": 4,
          "max": 7,
          "label": "Moderate"
        },
        {
          "min": 8,
          "max": 12,
          "label": "Severe"
        }
      ]
    },
    {
      "id": "westley_croup",
      "kind": "score",
      "title": "Westley Croup Score",
      "label": "WESTLEY CROUP",
      "enabled": true,
      "note": "Assess the settled child with minimal handling because agitation can worsen upper-airway obstruction. Select only findings that were actually assessed. A score supports severity assessment but does not replace clinical judgement, senior review, or urgent airway management when clinically indicated.",
      "source": "Ministry of Health Malaysia — Paediatric Protocols for Malaysian Hospitals, 5th Edition, Viral Croup, p.194; severity range at score 12 clarified using the published Westley classification. Checked 14 September 2026.",
      "sourceUrl": "https://www.moh.gov.my/images/04-penerbitan/penerbitan-klinikal/perkhidmatan-OG-dan-pediatrik/pediatrik/FA_-_Paediatric_Protocols_5th_Edition_MOH_PDF_1-compressed.pdf",
      "contexts": [],
      "fields": [
